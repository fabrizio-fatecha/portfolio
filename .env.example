# Google Sheets access via a service account. Copy to .env and fill in real
# values. Never commit .env or the downloaded service account JSON key file.
#
# These are read server-side only (Netlify Function + local scripts) — no
# VITE_ prefix, so they are never bundled into browser JS.
#
# Share the sheet with the service account's client_email as Viewer
# (Share > paste the email > Viewer). No public "anyone with the link"
# sharing is needed.

# The spreadsheet ID (from the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit)
SHEET_ID=your_google_sheet_id_here

# The full contents of the downloaded service account JSON key file,
# minified to a single line.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
